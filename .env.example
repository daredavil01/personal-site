# Supabase — copy this file to `.env` and fill in the values from your project's
# API settings (Project Settings → API). `.env` is gitignored.

# Public project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable key (Project Settings → API → Project API keys → Publishable).
# Safe to expose in the browser when RLS is enabled. Preferred over the anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only, used by the scripts/ importers (microblog:import, tags:migrate,
# --- images:upload). NEVER prefix with VITE_ and NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Workers AI, used by `npm run ask:index` to embed the corpus.
# --- Account ID: Cloudflare dashboard → Workers & Pages → Account details.
# --- Token: My Profile → API Tokens → a token with the "Workers AI: Read" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- /ask runtime secrets. These are NOT read from .env in production — set them
# --- on the deployment with `wrangler pages secret put <NAME>`. Listed here so
# --- `wrangler pages dev` picks them up locally.
GEMINI_API_KEY=
ASK_IP_SALT=
# Optional, only if you turn Turnstile on in /admin.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
