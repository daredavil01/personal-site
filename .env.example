# Supabase — copy this file to `.env` and fill in the values from your project's
# API settings (Project Settings → API). `.env` is gitignored.

# Public project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable key (Project Settings → API → Project API keys → Publishable).
# Safe to expose in the browser when RLS is enabled. Preferred over the anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only, used by scripts/import-to-supabase.mjs. NEVER prefix with VITE_
# --- and NEVER commit a real value. Only needed for the one-time data import.
SUPABASE_SERVICE_ROLE_KEY=
